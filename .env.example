# Local user/device configuration for TimeCapsuleSMB.
# Copy or regenerate with: tcapsule configure

TC_HOST='root@192.168.1.101'
# Optional: use this AirPort account's password for configured shared folders.
# Leave empty to use the AirPort device password. This does not isolate users.
TC_SMB_AIRPORT_ACCOUNT=''
TC_PASSWORD=''
TC_SSH_OPTS='-o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o KexAlgorithms=+diffie-hellman-group14-sha1 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
# Keep false to export the internal disk's ShareRoot folder.
TC_INTERNAL_SHARE_USE_DISK_ROOT='false'
TC_SMB_BROWSE_COMPATIBILITY='false'
TC_ANY_PROTOCOL='false'
TC_VFS_AIO_FORK_DISABLED='false'

# Drive timer settings are applied to built-in ATA disks during runtime startup.
# Set TC_ATA_IDLE_SECONDS=0 to disable the ATA idle timer.
# Leave TC_ATA_STANDBY blank to avoid changing standby, or set 0 to disable it.
TC_ATA_IDLE_SECONDS='300'
TC_ATA_STANDBY=''
