+/* AirPort Utility owns these accounts. SMB password-change/admin RPCs must
+ * not write a competing password database in RAM. */
+static NTSTATUS tc_airport_no_write(struct pdb_methods *methods, struct samu *user)
+{
+	return NT_STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS tc_airport_no_rename(struct pdb_methods *methods,
+				    struct samu *user, const char *name)
+{
+	return NT_STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS pdb_init_tc_airport(struct pdb_methods **methods, const char *location)
+{
+	struct smbpasswd_privates *state;
+	NTSTATUS status = pdb_init_smbpasswd(methods, location);
+	if (!NT_STATUS_IS_OK(status)) {
+		return status;
+	}
+	state = (*methods)->private_data;
+	state->tc_airport = true;
+	(*methods)->name = "tc_airport";
+	(*methods)->add_sam_account = tc_airport_no_write;
+	(*methods)->update_sam_account = tc_airport_no_write;
+	(*methods)->delete_sam_account = tc_airport_no_write;
+	(*methods)->rename_sam_account = tc_airport_no_rename;
+	return NT_STATUS_OK;
+}
+
 NTSTATUS pdb_smbpasswd_init(TALLOC_CTX *ctx)
 {
-	return smb_register_passdb(PASSDB_INTERFACE_VERSION, "smbpasswd", pdb_init_smbpasswd);
+	NTSTATUS status = smb_register_passdb(PASSDB_INTERFACE_VERSION,
+					      "smbpasswd", pdb_init_smbpasswd);
+	if (!NT_STATUS_IS_OK(status)) {
+		return status;
+	}
+	/* A distinct backend name makes older binaries fail closed rather than
+	 * silently ignore account identities or per-account read-only settings. */
+	return smb_register_passdb(PASSDB_INTERFACE_VERSION,
+				   "tc_airport", pdb_init_tc_airport);
 }
